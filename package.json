{
	"name": "sanveerosahan-com",
	"version": "0.2.0",
	"description": "Personal website of Sanveer Osahan. Built on Astro (Sienna theme).",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.2",
		"@astrojs/tailwind": "6.0.2",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/newsreader": "^5.2.10",
		"@playform/compress": "^0.2.3",
		"astro": "6.3.1",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^7.1.9",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.4.15",
		"autoprefixer": "^10.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.34.5"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"@biomejs/biome"
		]
	}
}
