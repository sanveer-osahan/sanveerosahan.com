---
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";
import { getPublishedPosts } from "@/utils/posts";
import ThemeToggle from "../ThemeToggle.astro";

const wordmark = siteConfig.title;
const hasPosts = (await getPublishedPosts()).length > 0;
const postsActive = Astro.url.pathname.replace(/\/$/, "").endsWith("/posts");
---

<header class="site-header" id="main-header">
	<a href={withBase("/")} class="wordmark">{wordmark}</a>
	<div class="header-right">
		{
			hasPosts && (
				<nav class="nav">
					<a href={withBase("/posts/")} class:list={{ active: postsActive }}>
						Posts
					</a>
				</nav>
			)
		}
		<ThemeToggle />
	</div>
</header>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 72px;
	}
	.wordmark {
		font-family: var(--font-serif);
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: hsl(var(--theme-text));
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.wordmark:hover {
		color: hsl(var(--theme-accent));
	}
	.header-right {
		display: flex;
		align-items: baseline;
		gap: 22px;
	}
	.nav {
		display: flex;
		align-items: baseline;
		gap: 22px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
	}
	.nav a {
		display: inline-block;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.2s ease;
	}
	/* Indicator overhangs the text slightly so the underline isn't abrupt. */
	.nav a::after {
		content: "";
		position: absolute;
		left: -3px;
		right: -3px;
		bottom: 0;
		height: 1px;
		background: transparent;
	}
	.nav a svg {
		display: inline-block;
		width: 14px;
		height: 14px;
		stroke: currentColor;
		vertical-align: -2px;
		margin-right: 6px;
	}
	.nav a:hover {
		color: hsl(var(--theme-accent));
	}
	.nav a.active {
		color: hsl(var(--theme-text));
	}
	.nav a.active::after {
		background: hsl(var(--theme-accent));
	}

	@media (max-width: 720px) {
		.site-header {
			margin-bottom: 36px;
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-areas:
				"wordmark theme"
				"nav nav";
			align-items: center;
			column-gap: 14px;
			row-gap: 14px;
		}
		.wordmark { grid-area: wordmark; }
		.header-right { display: contents; }
		.theme-toggle { grid-area: theme; justify-self: end; }
		.nav {
			grid-area: nav;
			gap: 22px;
			font-size: 13px;
			flex-wrap: wrap;
			justify-content: flex-start;
		}
		.nav a {
			/* Add top tap padding; desktop rule keeps the indicator space below. */
			padding-top: 6px;
		}
		.nav a svg {
			width: 13px;
			height: 13px;
		}
	}

	@media (max-width: 420px) {
		.site-header {
			margin-bottom: 28px;
			row-gap: 12px;
		}
		.wordmark {
			font-size: 16px;
		}
		.nav {
			gap: 18px;
			font-size: 12.5px;
		}
		.nav a svg {
			display: none;
		}
	}
</style>
