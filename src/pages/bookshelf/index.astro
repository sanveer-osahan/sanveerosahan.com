---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";
import { getReadings } from "@/utils/readings";

const meta = {
	description: `Books ${siteConfig.author} reads, and what he takes from them.`,
	title: "Bookshelf",
};

const readings = await getReadings();
---

<PageLayout meta={meta}>
	<section class="page">
		<h1>Bookshelf</h1>
		<p class="lede">Books I read, and what I take from them.</p>

		{
			readings.length === 0 ? (
				<p class="empty">Nothing on the shelf yet.</p>
			) : (
				<ul class="shelf">
					{readings.map((reading) => (
						<li class="shelf-item">
							<a href={withBase(`/bookshelf/${reading.id}/`)} class="shelf-link">
								{/* Covers keep their own aspect ratio, so no cover art gets
								    cropped. Astro supplies real dimensions at build time,
								    which is what stops the row from jumping as they load. */}
								<Image class="cover" src={reading.data.cover} alt={`Cover of ${reading.data.title}`} />
								<span class="shelf-text">
									<span class="shelf-title">
										{reading.data.draft && <span class="draft-badge">[Draft]</span>}
										{reading.data.title}
									</span>
									<span class="shelf-author">{reading.data.author.join(", ")}</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</PageLayout>

<style>
	.page {
		padding: 24px 0 80px;
	}
	.page h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(32px, 5vw, 44px);
		letter-spacing: -0.02em;
		line-height: 1.12;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.lede {
		margin: 12px 0 40px;
		font-size: 17px;
		line-height: 1.6;
		color: hsl(var(--theme-text-muted));
	}
	.empty {
		color: hsl(var(--theme-text) / 0.6);
		font-style: italic;
	}
	.shelf {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}
	/*
	 * One row per book: cover thumbnail, then the title. The cover column is a
	 * fixed width and the cover keeps its own ratio inside it, so books of
	 * different proportions still line their titles up down the page.
	 */
	.shelf-link {
		display: grid;
		grid-template-columns: 64px 1fr;
		gap: 20px;
		align-items: center;
	}
	.cover {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 3px;
		border: 1px solid hsl(var(--theme-text) / 0.1);
		box-shadow: 0 4px 12px hsl(var(--theme-text) / 0.12);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.shelf-link:hover .cover {
		transform: translateY(-2px);
		box-shadow: 0 8px 18px hsl(var(--theme-text) / 0.18);
	}
	.shelf-text {
		display: grid;
		gap: 3px;
	}
	.shelf-title {
		font-family: var(--font-serif);
		font-size: 19px;
		line-height: 1.3;
		color: hsl(var(--theme-text));
	}
	.shelf-link:hover .shelf-title {
		color: hsl(var(--theme-accent));
	}
	.shelf-author {
		font-family: var(--font-sans);
		font-size: 13px;
		color: hsl(var(--theme-text) / 0.6);
	}
	.draft-badge {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: hsl(var(--theme-accent));
		margin-right: 6px;
		vertical-align: 1px;
	}

	@media (max-width: 420px) {
		.shelf {
			gap: 22px;
		}
		.shelf-link {
			grid-template-columns: 52px 1fr;
			gap: 16px;
		}
		.shelf-title {
			font-size: 17px;
		}
	}
</style>
