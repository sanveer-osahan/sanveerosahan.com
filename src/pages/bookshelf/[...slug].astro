---
import { Image } from "astro:assets";
import { render } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";
import { getReadings } from "@/utils/readings";

export async function getStaticPaths() {
	const readings = await getReadings();
	return readings.map((reading) => ({
		params: { slug: reading.id },
		props: { reading },
	}));
}

const { reading } = Astro.props;
const { Content } = await render(reading);

/*
 * The Amazon mark, from Simple Icons. It is drawn in `currentColor` like the
 * social marks on the home page, so it takes the button's text color and works
 * in both themes. The path lives in a const because both buy links draw it.
 */
const AMAZON_MARK =
	"M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.13.226-.088.39-.046.525.13.12.174.09.336-.12.48-.256.19-.6.41-1.006.654-1.244.743-2.64 1.316-4.185 1.726a17.617 17.617 0 01-10.951-.577 17.88 17.88 0 01-5.43-3.35c-.1-.074-.151-.15-.151-.22 0-.047.021-.09.051-.13zm6.565-6.218c0-1.005.247-1.863.743-2.577.495-.71 1.17-1.25 2.04-1.615.796-.335 1.756-.575 2.912-.72.39-.046 1.033-.103 1.92-.174v-.37c0-.93-.105-1.558-.3-1.875-.302-.43-.78-.65-1.44-.65h-.182c-.48.046-.896.196-1.246.46-.35.27-.575.63-.675 1.096-.06.3-.206.465-.435.51l-2.52-.315c-.248-.06-.372-.18-.372-.39 0-.046.007-.09.022-.15.247-1.29.855-2.25 1.82-2.88.976-.616 2.1-.975 3.39-1.05h.54c1.65 0 2.957.434 3.888 1.29.135.15.27.3.405.48.12.165.224.314.283.45.075.134.15.33.195.57.06.254.105.42.135.51.03.104.062.3.076.615.01.313.02.493.02.553v5.28c0 .376.06.72.165 1.036.105.313.21.54.315.674l.51.674c.09.136.136.256.136.36 0 .12-.06.226-.18.314-1.2 1.05-1.86 1.62-1.963 1.71-.165.135-.375.15-.63.045a6.062 6.062 0 01-.526-.496l-.31-.347a9.391 9.391 0 01-.317-.42l-.3-.435c-.81.886-1.603 1.44-2.4 1.665-.494.15-1.093.227-1.83.227-1.11 0-2.04-.343-2.76-1.034-.72-.69-1.08-1.665-1.08-2.94l-.05-.076zm3.753-.438c0 .566.14 1.02.425 1.364.285.34.675.512 1.155.512.045 0 .106-.007.195-.02.09-.016.134-.023.166-.023.614-.16 1.08-.553 1.424-1.178.165-.28.285-.58.36-.91.09-.32.12-.59.135-.8.015-.195.015-.54.015-1.005v-.54c-.84 0-1.484.06-1.92.18-1.275.36-1.92 1.17-1.92 2.43l-.035-.02zm9.162 7.027c.03-.06.075-.11.132-.17.362-.243.714-.41 1.05-.5a8.094 8.094 0 011.612-.24c.14-.012.28 0 .41.03.65.06 1.05.168 1.172.33.063.09.099.228.099.39v.15c0 .51-.149 1.11-.424 1.8-.278.69-.664 1.248-1.156 1.68-.073.06-.14.09-.197.09-.03 0-.06 0-.09-.012-.09-.044-.107-.12-.064-.24.54-1.26.806-2.143.806-2.64 0-.15-.03-.27-.087-.344-.145-.166-.55-.257-1.224-.257-.243 0-.533.016-.87.046-.363.045-.7.09-1 .135-.09 0-.148-.014-.18-.044-.03-.03-.036-.047-.02-.077 0-.017.006-.03.02-.063v-.06z";

const authors = reading.data.author.join(" and ");

/*
 * A Reading goes live with the book details and an empty body, then grows one
 * chapter at a time. An empty body therefore means "still reading", which is
 * the job the dropped `status` field would have done.
 */
const hasLearnings = (reading.body ?? "").trim().length > 0;

const meta = {
	description: `What I took from ${reading.data.title} by ${authors}.`,
	title: reading.data.title,
	ogImage: reading.data.cover.src,
	ogImageWidth: reading.data.cover.width,
	ogImageHeight: reading.data.cover.height,
};

const yearFormat = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<PageLayout meta={meta}>
	<article class="reading">
		<a href={withBase("/bookshelf/")} class="back">Bookshelf</a>
		<h1>
			{reading.data.draft && <span class="draft-badge">[Draft]</span>}
			{reading.data.title}
		</h1>
		{reading.data.subtitle && <p class="subtitle">{reading.data.subtitle}</p>}

		<div class="book">
			<Image class="cover" src={reading.data.cover} alt={`Cover of ${reading.data.title}`} />

			<div class="book-details">
				<dl class="facts">
					<dt>{reading.data.author.length > 1 ? "Authors" : "Author"}</dt>
					<dd>{reading.data.author.join(", ")}</dd>

					<dt>Published</dt>
					<dd>
						<time datetime={reading.data.publishedDate.toISOString()}>
							{yearFormat.format(reading.data.publishedDate)}
						</time>
					</dd>

					<dt>Publisher</dt>
					<dd>{reading.data.publisher}</dd>

					<dt>Pages</dt>
					<dd>{reading.data.pages}</dd>
				</dl>

				{
					(reading.data.amazonCom || reading.data.amazonIn) && (
						<div class="buy">
							{reading.data.amazonCom && (
								<a class="buy-link" href={reading.data.amazonCom} target="_blank" rel="noopener noreferrer">
									<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
										<path fill="currentColor" d={AMAZON_MARK} />
									</svg>
									<span>Amazon.com</span>
								</a>
							)}
							{reading.data.amazonIn && (
								<a class="buy-link" href={reading.data.amazonIn} target="_blank" rel="noopener noreferrer">
									<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
										<path fill="currentColor" d={AMAZON_MARK} />
									</svg>
									<span>Amazon.in</span>
								</a>
							)}
						</div>
					)
				}
			</div>
		</div>

		<hr class="rule" />

		{
			hasLearnings ? (
				<div class="prose">
					<Content />
				</div>
			) : (
				<p class="in-progress">Reading in progress. Learnings to follow.</p>
			)
		}
	</article>
</PageLayout>

<style>
	.reading {
		padding: 8px 0 80px;
	}
	.back {
		display: inline-block;
		margin-bottom: 28px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.66);
	}
	.back:hover {
		color: hsl(var(--theme-accent));
	}
	.reading h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(30px, 4.6vw, 40px);
		letter-spacing: -0.02em;
		line-height: 1.14;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.subtitle {
		margin: 10px 0 0;
		font-family: var(--font-serif);
		font-size: clamp(17px, 2.2vw, 20px);
		line-height: 1.4;
		color: hsl(var(--theme-text-muted));
	}
	.draft-badge {
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: hsl(var(--theme-accent));
		margin-right: 8px;
		vertical-align: 4px;
	}
	.book {
		margin-top: 32px;
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 32px;
		align-items: start;
	}
	.cover {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 4px;
		border: 1px solid hsl(var(--theme-text) / 0.1);
		box-shadow: 0 6px 18px hsl(var(--theme-text) / 0.12);
	}
	.facts {
		margin: 0;
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 20px;
		row-gap: 8px;
		align-items: baseline;
	}
	.facts dt {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: hsl(var(--theme-text) / 0.55);
	}
	.facts dd {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 16.5px;
		color: hsl(var(--theme-text));
	}
	.buy {
		margin-top: 28px;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	/* Matches the social buttons on the home page, so the site keeps one
	   button shape rather than inventing a second. */
	.buy-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		border-radius: 10px;
		border: 1px solid hsl(var(--theme-text) / 0.14);
		color: hsl(var(--theme-text));
		font-family: var(--font-serif);
		font-size: 15px;
		line-height: 1;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}
	.buy-link svg {
		flex: none;
	}
	.buy-link:hover {
		background-color: hsl(var(--theme-text) / 0.05);
		border-color: hsl(var(--theme-text) / 0.3);
		color: hsl(var(--theme-link));
	}
	.rule {
		margin: 48px 0 40px;
		border: 0;
		border-top: 1px solid var(--hairline);
	}
	.in-progress {
		margin: 0;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 17px;
		color: hsl(var(--theme-text) / 0.6);
	}
	/*
	 * Tailwind preflight strips the margins off headings and paragraphs, so the
	 * rendered Markdown needs them put back. These values match the ones on the
	 * Article page on purpose: a chapter heading in a Reading and a section
	 * heading in an Article are the same thing to a reader, so they must not
	 * drift apart.
	 */
	.prose :global(p) {
		margin: 0 0 1.1em;
	}
	.prose :global(h2) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(22px, 3vw, 27px);
		letter-spacing: -0.015em;
		line-height: 1.2;
		color: hsl(var(--theme-text));
		margin: 1.8em 0 0.6em;
	}
	/* The first chapter sits right below the rule, which already spaces it. */
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.prose :global(h3) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(18px, 2.4vw, 21px);
		letter-spacing: -0.012em;
		line-height: 1.25;
		color: hsl(var(--theme-text));
		margin: 1.5em 0 0.5em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.1em;
		padding-left: 1.4em;
	}
	.prose :global(ul) {
		list-style: disc;
	}
	.prose :global(ol) {
		list-style: decimal;
	}
	.prose :global(li) {
		margin: 0 0 0.4em;
	}
	.prose :global(blockquote) {
		margin: 1.5em 0;
		padding-left: 18px;
		border-left: 2px solid var(--hairline);
		font-style: italic;
		color: hsl(var(--theme-text-muted));
	}
	.prose :global(strong) {
		font-weight: 600;
	}
	.prose :global(a) {
		color: hsl(var(--theme-link));
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.prose :global(hr) {
		margin: 2em 0;
		border: 0;
		border-top: 1px solid var(--hairline);
	}

	@media (max-width: 720px) {
		.book {
			grid-template-columns: 140px 1fr;
			gap: 24px;
		}
	}
	@media (max-width: 480px) {
		.book {
			grid-template-columns: 1fr;
			gap: 24px;
		}
		.cover {
			max-width: 180px;
		}
	}
</style>
