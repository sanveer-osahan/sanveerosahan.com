---
import { Image } from "astro:assets";
import NoteWall from "@/components/NoteWall.astro";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";
import { getPublishedArticles } from "@/utils/articles";
import { getNotes } from "@/utils/notes";
import { getReadings } from "@/utils/readings";
import dp from "../assets/Casual_DP.jpg";

const FEED_LIMIT = 5;
const NOTE_LIMIT = 3;
const BOOK_LIMIT = 3;
const articles = await getPublishedArticles();
const feedArticles = articles.slice(0, FEED_LIMIT);
const notes = await getNotes();
const feedNotes = notes.slice(0, NOTE_LIMIT);
const readings = await getReadings();
const feedReadings = readings.slice(0, BOOK_LIMIT);
const dateFormat = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "short",
	day: "numeric",
});
---

<PageLayout meta={{ title: siteConfig.title, description: siteConfig.description }}>
	<section class="intro">
		<div class="bio">
			<h1>Sanveer Singh Osahan</h1>
			<p class="tagline">
				I build customer value through engineering, leading teams that ship
				what customers trust and businesses grow on.
			</p>

			<div class="prose">
			<p>
				I'm a software engineer, and the Data + AI ecosystem is where I
				love to work. I build the systems that make data trustworthy at scale: data
				platforms, cataloging, lineage, and the extraction pipelines
				underneath them all.
			</p>
			<p>
				The problems I like only show up at scale. At <a
					href="https://atlan.com"
					target="_blank"
					rel="noopener noreferrer">Atlan</a
				>, I designed the industry's first incremental metadata extraction,
				taking extraction pipelines from hours down to minutes. It went on to
				power Atlan's Snowflake, Databricks, and Oracle connectors for over a
				hundred customers. Before that, I was a founding engineer at <a
					href="https://boltic.io"
					target="_blank"
					rel="noopener noreferrer">Boltic</a
				>, building the core of a SaaS ETL platform.
			</p>
			<p>
				I care about two things: the customer on the far end of the
				system, and the engineers building it. A lot of my work is mentoring,
				helping people reason about system design, performance, and the
				quality bar that makes software worth trusting by the customers using it.
			</p>
			<p>
				<a href="https://databricks.com" target="_blank" rel="noopener noreferrer"
					>Databricks</a
				> is the platform I go deepest on. I helped strengthen Atlan's
				partnership with Databricks, working with their product and
				engineering teams to ship the System Tables for <a
					href="https://docs.databricks.com/aws/en/admin/system-tables/lineage"
					target="_blank"
					rel="noopener noreferrer">Lineage</a
				> and <a
					href="https://docs.databricks.com/aws/en/admin/system-tables/query-history"
					target="_blank"
					rel="noopener noreferrer">Query History</a
				> that our shared customers now derive real value from. I follow what
				they ship closely and enjoy seeing how their newest pieces solve real
					problems in the Data + AI space.
				</p>
			</div>
		</div>

		<aside class="sidecard">
			<Image
				class="avatar"
				src={dp}
				alt="Sanveer Singh Osahan"
				width={480}
				height={480}
				loading="eager"
			/>

			<div class="socials">
				<a
					class="social"
					href="https://github.com/sanveer-osahan"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
					<span>GitHub</span>
				</a>

				<a
					class="social"
					href="https://x.com/sanveer_osahan"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>
					<span>X</span>
				</a>

				<a
					class="social"
					href="https://sanveerosahan.substack.com/"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M0 0v3.4h24V0H0zm0 8.5V24l12-6.85L24 24V8.5H0z"
						></path>
					</svg>
					<span>Substack</span>
				</a>

				<a
					class="social"
					href="https://medium.com/@sanveer1995"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
						></path>
					</svg>
					<span>Medium</span>
				</a>
			</div>
		</aside>
	</section>

	{
		feedArticles.length > 0 && (
			<section class="feed">
				<h2>Articles</h2>
				<ul class="feed-list">
					{feedArticles.map((article) => (
						<li class="feed-item">
							<a href={withBase(`/articles/${article.id}/`)} class="feed-link">
								<span class="feed-title">{article.data.title}</span>
								<time datetime={article.data.publishDate.toISOString()} class="feed-date">
									{dateFormat.format(article.data.publishDate)}
								</time>
							</a>
						</li>
					))}
				</ul>
				{articles.length > FEED_LIMIT && (
					<a href={withBase("/articles/")} class="feed-more">
						See all articles
					</a>
				)}
			</section>
		)
	}

	{
		feedNotes.length > 0 && (
			<section class="feed">
				<h2>Notes</h2>
				{/* No permalinks here: the reader just read the note, so linking to
				    it again is a dead end. "See all notes" is the way onward. */}
				<NoteWall notes={feedNotes} />
				{notes.length > NOTE_LIMIT && (
					<a href={withBase("/notes/")} class="feed-more">
						See all notes
					</a>
				)}
			</section>
		)
	}

	{
		feedReadings.length > 0 && (
			<section class="feed">
				{/* "From my bookshelf" stays true whether a book is finished or opened
				    yesterday. A Reading carries no status, so no heading here can
				    claim one. */}
				<h2>From my bookshelf</h2>
				<ul class="book-row">
					{feedReadings.map((reading) => (
						<li>
							<a href={withBase(`/bookshelf/${reading.id}/`)} class="book-link">
								<Image
									class="book-cover"
									src={reading.data.cover}
									alt={`Cover of ${reading.data.title}`}
								/>
								<span class="book-title">{reading.data.title}</span>
								<span class="book-author">{reading.data.author.join(", ")}</span>
							</a>
						</li>
					))}
				</ul>
				{readings.length > BOOK_LIMIT && (
					<a href={withBase("/bookshelf/")} class="feed-more">
						See the whole shelf
					</a>
				)}
			</section>
		)
	}
</PageLayout>

<style>
	/*
	 * Home breaks out of the 760px site shell to ~940px so the bio and avatar
	 * can sit side by side. Scoped to this page only — Header, Footer, and the
	 * rest of the site stay at 760px. margin-left:50% + translateX(-50%)
	 * re-centers on the viewport regardless of the narrower parent.
	 */
	.intro {
		width: min(940px, 100vw - 3rem);
		margin-left: 50%;
		transform: translateX(-50%);
		padding: 24px 0 48px;
		display: grid;
		grid-template-columns: 1fr 240px;
		gap: 48px;
		align-items: start;
	}
	.bio {
		max-width: 62ch;
	}
	.sidecard {
		display: grid;
		gap: 16px;
		justify-items: stretch;
	}
	.avatar {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		border-radius: 12px;
		border: 1px solid hsl(var(--theme-text) / 0.08);
		object-fit: cover;
		display: block;
	}
	.socials {
		display: grid;
		gap: 10px;
	}
	.social {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		border-radius: 10px;
		border: 1px solid hsl(var(--theme-text) / 0.14);
		color: hsl(var(--theme-text));
		font-family: var(--font-serif);
		font-size: 15px;
		line-height: 1;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease,
			color 0.2s ease;
	}
	.social svg {
		flex: none;
	}
	.social:hover {
		background-color: hsl(var(--theme-text) / 0.05);
		border-color: hsl(var(--theme-text) / 0.3);
		color: hsl(var(--theme-link));
	}
	@media (max-width: 720px) {
		.intro {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.sidecard {
			order: -1;
			justify-items: start;
		}
		.avatar {
			width: 140px;
		}
		.socials {
			grid-auto-flow: column;
			justify-content: start;
		}
	}
	.intro h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(32px, 5vw, 44px);
		letter-spacing: -0.02em;
		line-height: 1.12;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.tagline {
		font-family: var(--font-serif);
		font-size: clamp(18px, 2.4vw, 22px);
		line-height: 1.4;
		color: hsl(var(--theme-accent));
		margin: 16px 0 0;
	}
	.prose {
		margin-top: 32px;
		display: grid;
		gap: 18px;
	}
	.prose p {
		font-size: 17px;
		line-height: 1.7;
		color: hsl(var(--theme-text-muted));
		margin: 0;
	}
	.prose a {
		color: hsl(var(--theme-link));
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.feed {
		/* Same breakout as .intro so its left edge lines up with the bio text. */
		width: min(940px, 100vw - 3rem);
		margin-left: 50%;
		transform: translateX(-50%);
		padding: 32px 0 80px;
		border-top: 1px solid var(--hairline);
	}
	.feed h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(22px, 3vw, 27px);
		letter-spacing: -0.015em;
		color: hsl(var(--theme-text));
		margin: 0 0 24px;
	}
	.feed-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.feed-link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}
	.feed-title {
		font-family: var(--font-serif);
		font-size: 17px;
		color: hsl(var(--theme-text));
	}
	.feed-link:hover .feed-title {
		color: hsl(var(--theme-accent));
	}
	.feed-date {
		flex: none;
		font-family: var(--font-sans);
		font-size: 13px;
		color: hsl(var(--theme-text) / 0.6);
	}
	.feed-more {
		display: inline-block;
		margin-top: 24px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-accent));
	}
	/*
	 * A left-aligned row of fixed-width covers, not a grid. The home page
	 * breaks out to 940px, and three covers stretched across that width would
	 * outweigh the writing above them.
	 */
	.book-row {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: start;
		gap: 28px;
	}
	.book-link {
		display: grid;
		gap: 4px;
		width: 128px;
	}
	.book-cover {
		width: 100%;
		height: auto;
		display: block;
		margin-bottom: 10px;
		border-radius: 4px;
		border: 1px solid hsl(var(--theme-text) / 0.1);
		box-shadow: 0 6px 18px hsl(var(--theme-text) / 0.12);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.book-link:hover .book-cover {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px hsl(var(--theme-text) / 0.18);
	}
	.book-title {
		font-family: var(--font-serif);
		font-size: 15px;
		line-height: 1.3;
		color: hsl(var(--theme-text));
	}
	.book-link:hover .book-title {
		color: hsl(var(--theme-accent));
	}
	.book-author {
		font-family: var(--font-sans);
		font-size: 12.5px;
		color: hsl(var(--theme-text) / 0.6);
	}
	@media (max-width: 720px) {
		.feed-link {
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
