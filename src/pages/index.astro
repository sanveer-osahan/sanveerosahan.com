---
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
---

<PageLayout meta={{ title: "Home", description: siteConfig.description }}>
	<section class="page">
		<h1>Home</h1>
	</section>
</PageLayout>

<style>
	.page {
		padding: 24px 0 80px;
	}
	.page h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(32px, 5vw, 44px);
		letter-spacing: -0.02em;
		line-height: 1.12;
		color: hsl(var(--theme-text));
		margin: 0;
	}
</style>
