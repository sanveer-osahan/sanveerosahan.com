---
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";
import { getPublishedArticles } from "@/utils/articles";

const meta = {
	description: `Articles by ${siteConfig.author}.`,
	title: "Articles",
};

const articles = await getPublishedArticles();
const dateFormat = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "short",
});
---

<PageLayout meta={meta}>
	<section class="page">
		<h1>Articles</h1>

		{
			articles.length === 0 ? (
				<p class="empty">Nothing published yet.</p>
			) : (
				<ul class="article-list">
					{articles.map((article) => (
						<li class="article-item">
							<a href={withBase(`/articles/${article.id}/`)} class="article-link">
								<span class="article-title">
									{article.data.draft && <span class="draft-badge">[Draft]</span>}
									{article.data.title}
								</span>
								<time datetime={article.data.publishDate.toISOString()} class="article-date">
									{dateFormat.format(article.data.publishDate)}
								</time>
							</a>
							<p class="article-desc">{article.data.description}</p>
						</li>
					))}
				</ul>
			)
		}
	</section>
</PageLayout>

<style>
	.page {
		padding: 24px 0 80px;
	}
	.page h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(32px, 5vw, 44px);
		letter-spacing: -0.02em;
		line-height: 1.12;
		color: hsl(var(--theme-text));
		margin: 0 0 40px;
	}
	.empty {
		color: hsl(var(--theme-text) / 0.6);
		font-style: italic;
	}
	.article-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}
	.article-link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}
	.article-title {
		font-family: var(--font-serif);
		font-size: 21px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: hsl(var(--theme-text));
	}
	.article-link:hover .article-title {
		color: hsl(var(--theme-accent));
	}
	.draft-badge {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: hsl(var(--theme-accent));
		margin-right: 8px;
		vertical-align: 2px;
	}
	.article-date {
		flex: none;
		font-family: var(--font-sans);
		font-size: 13px;
		color: hsl(var(--theme-text) / 0.6);
	}
	.article-desc {
		margin: 8px 0 0;
		font-size: 16.5px;
		line-height: 1.55;
		color: hsl(var(--theme-text) / 0.78);
	}
	@media (max-width: 720px) {
		.article-link {
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
