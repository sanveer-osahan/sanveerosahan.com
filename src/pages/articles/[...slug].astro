---
import PageLayout from "@/layouts/Base.astro";
import { getReadingTime } from "@/utils/reading-time";
import { withBase } from "@/utils/path";
import { getPublishedArticles } from "@/utils/articles";
import { render } from "astro:content";

export async function getStaticPaths() {
	const articles = await getPublishedArticles();
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);

const meta = {
	articleDate: article.data.publishDate.toISOString(),
	description: article.data.description,
	title: article.data.title,
};

const dateFormat = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "long",
});

const readingMinutes = getReadingTime(article.body ?? "");
---

<PageLayout meta={meta}>
	<article class="article">
		<a href={withBase("/articles/")} class="back">Articles</a>
		<h1>
			{article.data.draft && <span class="draft-badge">[Draft]</span>}
			{article.data.title}
		</h1>
		<div class="article-meta">
			<time datetime={article.data.publishDate.toISOString()}>
				{dateFormat.format(article.data.publishDate)}
			</time>
			<span class="meta-sep" aria-hidden="true">·</span>
			<span class="read-time">{readingMinutes} min read</span>
			{
				article.data.videoUrl && (
					<>
						<span class="meta-sep" aria-hidden="true">·</span>
						<a href={article.data.videoUrl} class="video-link" rel="noopener" target="_blank">
							Watch on YouTube
						</a>
					</>
				)
			}
		</div>
		<div class="prose">
			<Content />
		</div>
	</article>
</PageLayout>

<style>
	.article {
		padding: 8px 0 80px;
	}
	.back {
		display: inline-block;
		margin-bottom: 28px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.66);
	}
	.back:hover {
		color: hsl(var(--theme-accent));
	}
	.article h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(30px, 4.6vw, 42px);
		letter-spacing: -0.02em;
		line-height: 1.14;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.draft-badge {
		font-family: var(--font-sans);
		font-size: 0.42em;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: hsl(var(--theme-accent));
		margin-right: 10px;
		vertical-align: middle;
	}
	.article-meta {
		display: flex;
		align-items: baseline;
		gap: 18px;
		margin: 16px 0 40px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.6);
	}
	.meta-sep {
		color: hsl(var(--theme-text) / 0.35);
	}
	.video-link {
		color: hsl(var(--theme-accent));
	}
	.prose :global(p) {
		margin: 0 0 1.1em;
	}
	.prose :global(h2) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(22px, 3vw, 27px);
		letter-spacing: -0.015em;
		line-height: 1.2;
		color: hsl(var(--theme-text));
		margin: 1.8em 0 0.6em;
	}
	.prose :global(h3) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(18px, 2.4vw, 21px);
		letter-spacing: -0.012em;
		line-height: 1.25;
		color: hsl(var(--theme-text));
		margin: 1.5em 0 0.5em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.1em;
		padding-left: 1.4em;
	}
	.prose :global(ul) {
		list-style: disc;
	}
	.prose :global(ol) {
		list-style: decimal;
	}
	.prose :global(li) {
		margin: 0 0 0.5em;
		padding-left: 0.2em;
	}
	.prose :global(li::marker) {
		color: hsl(var(--theme-text) / 0.45);
	}
	.prose :global(li > ul),
	.prose :global(li > ol) {
		margin: 0.5em 0 0;
	}
	.prose :global(li > p) {
		margin: 0 0 0.5em;
	}
	.prose :global(li > p:last-child) {
		margin-bottom: 0;
	}
	.prose :global(.table-wrap) {
		overflow-x: auto;
		margin: 1.5em 0;
	}
	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-sans);
		font-size: 14.5px;
		line-height: 1.45;
		margin: 1.5em 0;
	}
	.prose :global(.table-wrap table) {
		margin: 0;
	}
	.prose :global(th),
	.prose :global(td) {
		text-align: left;
		padding: 9px 14px;
		border-bottom: 1px solid var(--hairline);
		vertical-align: top;
	}
	.prose :global(thead th) {
		font-weight: 600;
		color: hsl(var(--theme-text));
		border-bottom: 1.5px solid var(--hairline);
	}
	.prose :global(tbody td) {
		color: hsl(var(--theme-text-muted));
	}
	.prose :global(td[rowspan]) {
		font-weight: 600;
		color: hsl(var(--theme-text));
		background: var(--accent-soft);
		border-right: 1px solid var(--hairline);
		white-space: nowrap;
	}
	.prose :global(.tabset) {
		margin: 1.6em 0;
		border: 1px solid var(--hairline);
		border-radius: 10px;
		background: var(--paper);
		overflow: hidden;
		font-family: var(--font-sans);
	}
	.prose :global(.tabset .tabset) {
		margin: 0.4em 0 0.2em;
		border-radius: 8px;
	}
	.prose :global(.tabr) {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}
	.prose :global(.tabnav) {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		padding: 8px;
		background: var(--accent-soft);
		border-bottom: 1px solid var(--hairline);
	}
	.prose :global(.tabnav label) {
		cursor: pointer;
		padding: 7px 14px;
		font-size: 13.5px;
		font-weight: 600;
		line-height: 1;
		color: hsl(var(--theme-text-muted));
		border: 1px solid transparent;
		border-radius: 7px;
	}
	.prose :global(.tabnav label:hover) {
		color: hsl(var(--theme-text));
	}
	.prose :global(.tabpanes) {
		padding: 16px 18px;
	}
	.prose :global(.tabset .tabset .tabpanes) {
		padding: 13px 14px;
	}
	.prose :global(.pane) {
		display: none;
	}
	.prose :global(.pane h4) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 16px;
		margin: 0 0 0.5em;
		color: hsl(var(--theme-text));
	}
	.prose :global(.pane h4:not(:first-child)) {
		margin-top: 1em;
	}
	.prose :global(.pane ol) {
		margin: 0 0 0.6em;
		padding-left: 1.25em;
	}
	.prose :global(.pane li) {
		margin: 0 0 0.45em;
		color: hsl(var(--theme-text-muted));
		font-size: 15px;
	}
	.prose :global(.pane p) {
		color: hsl(var(--theme-text-muted));
		font-size: 15px;
		margin: 0 0 0.6em;
	}
	.prose :global(.pane pre) {
		background: var(--accent-soft);
		border: 1px solid var(--hairline);
		border-radius: 6px;
		padding: 10px 12px;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.5;
		margin: 0.35em 0 0.85em;
	}
	.prose :global(.pane pre code) {
		font-family: var(--font-mono);
	}
	.prose :global(.pane .note) {
		font-size: 13.5px;
		border-left: 2px solid hsl(var(--theme-accent));
		padding-left: 10px;
	}
	.prose :global(#agent-cc:checked ~ .tabnav label[for="agent-cc"]),
	.prose :global(#agent-cx:checked ~ .tabnav label[for="agent-cx"]),
	.prose :global(#cc-mac:checked ~ .tabnav label[for="cc-mac"]),
	.prose :global(#cc-win:checked ~ .tabnav label[for="cc-win"]),
	.prose :global(#cc-lin:checked ~ .tabnav label[for="cc-lin"]),
	.prose :global(#cx-mac:checked ~ .tabnav label[for="cx-mac"]),
	.prose :global(#cx-win:checked ~ .tabnav label[for="cx-win"]),
	.prose :global(#cx-lin:checked ~ .tabnav label[for="cx-lin"]),
	.prose :global(#pagent-cc:checked ~ .tabnav label[for="pagent-cc"]),
	.prose :global(#pagent-cx:checked ~ .tabnav label[for="pagent-cx"]),
	.prose :global(#pcc-mac:checked ~ .tabnav label[for="pcc-mac"]),
	.prose :global(#pcc-win:checked ~ .tabnav label[for="pcc-win"]),
	.prose :global(#pcc-lin:checked ~ .tabnav label[for="pcc-lin"]),
	.prose :global(#pcx-mac:checked ~ .tabnav label[for="pcx-mac"]),
	.prose :global(#pcx-win:checked ~ .tabnav label[for="pcx-win"]),
	.prose :global(#pcx-lin:checked ~ .tabnav label[for="pcx-lin"]),
	.prose :global(#eagent-cc:checked ~ .tabnav label[for="eagent-cc"]),
	.prose :global(#eagent-cx:checked ~ .tabnav label[for="eagent-cx"]),
	.prose :global(#ecc-mac:checked ~ .tabnav label[for="ecc-mac"]),
	.prose :global(#ecc-win:checked ~ .tabnav label[for="ecc-win"]),
	.prose :global(#ecc-lin:checked ~ .tabnav label[for="ecc-lin"]),
	.prose :global(#ecx-mac:checked ~ .tabnav label[for="ecx-mac"]),
	.prose :global(#ecx-win:checked ~ .tabnav label[for="ecx-win"]),
	.prose :global(#ecx-lin:checked ~ .tabnav label[for="ecx-lin"]),
	.prose :global(#zagent-cc:checked ~ .tabnav label[for="zagent-cc"]),
	.prose :global(#zagent-cx:checked ~ .tabnav label[for="zagent-cx"]),
	.prose :global(#zcc-mac:checked ~ .tabnav label[for="zcc-mac"]),
	.prose :global(#zcc-win:checked ~ .tabnav label[for="zcc-win"]),
	.prose :global(#zcc-lin:checked ~ .tabnav label[for="zcc-lin"]),
	.prose :global(#zcx-mac:checked ~ .tabnav label[for="zcx-mac"]),
	.prose :global(#zcx-win:checked ~ .tabnav label[for="zcx-win"]),
	.prose :global(#zcx-lin:checked ~ .tabnav label[for="zcx-lin"]) {
		color: hsl(var(--theme-accent));
		background: var(--paper);
		border-color: var(--hairline);
	}
	.prose :global(#agent-cc:checked ~ .tabpanes > .pane-agent-cc),
	.prose :global(#agent-cx:checked ~ .tabpanes > .pane-agent-cx),
	.prose :global(#cc-mac:checked ~ .tabpanes > .pane-cc-mac),
	.prose :global(#cc-win:checked ~ .tabpanes > .pane-cc-win),
	.prose :global(#cc-lin:checked ~ .tabpanes > .pane-cc-lin),
	.prose :global(#cx-mac:checked ~ .tabpanes > .pane-cx-mac),
	.prose :global(#cx-win:checked ~ .tabpanes > .pane-cx-win),
	.prose :global(#cx-lin:checked ~ .tabpanes > .pane-cx-lin),
	.prose :global(#pagent-cc:checked ~ .tabpanes > .pane-pagent-cc),
	.prose :global(#pagent-cx:checked ~ .tabpanes > .pane-pagent-cx),
	.prose :global(#pcc-mac:checked ~ .tabpanes > .pane-pcc-mac),
	.prose :global(#pcc-win:checked ~ .tabpanes > .pane-pcc-win),
	.prose :global(#pcc-lin:checked ~ .tabpanes > .pane-pcc-lin),
	.prose :global(#pcx-mac:checked ~ .tabpanes > .pane-pcx-mac),
	.prose :global(#pcx-win:checked ~ .tabpanes > .pane-pcx-win),
	.prose :global(#pcx-lin:checked ~ .tabpanes > .pane-pcx-lin),
	.prose :global(#eagent-cc:checked ~ .tabpanes > .pane-eagent-cc),
	.prose :global(#eagent-cx:checked ~ .tabpanes > .pane-eagent-cx),
	.prose :global(#ecc-mac:checked ~ .tabpanes > .pane-ecc-mac),
	.prose :global(#ecc-win:checked ~ .tabpanes > .pane-ecc-win),
	.prose :global(#ecc-lin:checked ~ .tabpanes > .pane-ecc-lin),
	.prose :global(#ecx-mac:checked ~ .tabpanes > .pane-ecx-mac),
	.prose :global(#ecx-win:checked ~ .tabpanes > .pane-ecx-win),
	.prose :global(#ecx-lin:checked ~ .tabpanes > .pane-ecx-lin),
	.prose :global(#zagent-cc:checked ~ .tabpanes > .pane-zagent-cc),
	.prose :global(#zagent-cx:checked ~ .tabpanes > .pane-zagent-cx),
	.prose :global(#zcc-mac:checked ~ .tabpanes > .pane-zcc-mac),
	.prose :global(#zcc-win:checked ~ .tabpanes > .pane-zcc-win),
	.prose :global(#zcc-lin:checked ~ .tabpanes > .pane-zcc-lin),
	.prose :global(#zcx-mac:checked ~ .tabpanes > .pane-zcx-mac),
	.prose :global(#zcx-win:checked ~ .tabpanes > .pane-zcx-win),
	.prose :global(#zcx-lin:checked ~ .tabpanes > .pane-zcx-lin) {
		display: block;
	}
	.prose :global(a) {
		color: hsl(var(--theme-link));
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1px;
	}
	.prose :global(a:hover) {
		text-decoration: none;
	}
	/*
	 * Markdown code blocks and inline code. Without these they inherit the
	 * body size, which is set for serif prose and reads oversized in mono.
	 * 13px matches the tabset panes above.
	 */
	.prose :global(pre) {
		font-size: 13px;
		line-height: 1.55;
	}
	.prose :global(pre code) {
		font-size: inherit;
	}
	.prose :global(:not(pre) > code) {
		font-size: 0.88em;
	}

	.prose :global(.code-block) {
		position: relative;
		margin: 0.35em 0 0.85em;
	}
	.prose :global(.code-block > pre) {
		margin: 0;
		padding-right: 42px;
	}
	.prose :global(.copy-btn) {
		position: absolute;
		top: 6px;
		right: 6px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 1px solid var(--hairline);
		border-radius: 6px;
		background: var(--paper);
		color: hsl(var(--theme-text-muted));
		cursor: pointer;
		opacity: 0.75;
		transition: opacity 0.15s, color 0.15s;
	}
	.prose :global(.copy-btn:hover),
	.prose :global(.copy-btn.copied) {
		opacity: 1;
		color: hsl(var(--theme-accent));
	}
	.prose :global(.copy-btn svg) {
		width: 15px;
		height: 15px;
	}
</style>

<script>
	const COPY_ICON =
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
	const DONE_ICON =
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

	document.querySelectorAll(".prose pre").forEach((pre) => {
		const code = pre.querySelector("code");
		if (!code || !pre.parentNode) return;
		const wrap = document.createElement("div");
		wrap.className = "code-block";
		pre.parentNode.insertBefore(wrap, pre);
		wrap.appendChild(pre);

		const btn = document.createElement("button");
		btn.type = "button";
		btn.className = "copy-btn";
		btn.setAttribute("aria-label", "Copy to clipboard");
		btn.innerHTML = COPY_ICON;
		btn.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(code.textContent);
				btn.innerHTML = DONE_ICON;
				btn.classList.add("copied");
				btn.setAttribute("aria-label", "Copied");
				setTimeout(() => {
					btn.innerHTML = COPY_ICON;
					btn.classList.remove("copied");
					btn.setAttribute("aria-label", "Copy to clipboard");
				}, 1500);
			} catch (e) {}
		});
		wrap.appendChild(btn);
	});
</script>
