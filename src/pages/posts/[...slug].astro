---
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";
import { getPublishedPosts } from "@/utils/posts";
import { render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const meta = {
	articleDate: post.data.publishDate.toISOString(),
	description: post.data.description,
	title: post.data.title,
};

const dateFormat = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<PageLayout meta={meta}>
	<article class="post">
		<a href={withBase("/posts/")} class="back">Posts</a>
		<h1>
			{post.data.draft && <span class="draft-badge">[Draft]</span>}
			{post.data.title}
		</h1>
		<div class="post-meta">
			<time datetime={post.data.publishDate.toISOString()}>
				{dateFormat.format(post.data.publishDate)}
			</time>
			{
				post.data.videoUrl && (
					<a href={post.data.videoUrl} class="video-link" rel="noopener" target="_blank">
						Watch on YouTube
					</a>
				)
			}
		</div>
		<div class="prose">
			<Content />
		</div>
	</article>
</PageLayout>

<style>
	.post {
		padding: 8px 0 80px;
	}
	.back {
		display: inline-block;
		margin-bottom: 28px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.66);
	}
	.back:hover {
		color: hsl(var(--theme-accent));
	}
	.post h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(30px, 4.6vw, 42px);
		letter-spacing: -0.02em;
		line-height: 1.14;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.draft-badge {
		font-family: var(--font-sans);
		font-size: 0.42em;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: hsl(var(--theme-accent));
		margin-right: 10px;
		vertical-align: middle;
	}
	.post-meta {
		display: flex;
		align-items: baseline;
		gap: 18px;
		margin: 16px 0 40px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.6);
	}
	.video-link {
		color: hsl(var(--theme-accent));
	}
	.prose :global(p) {
		margin: 0 0 1.1em;
	}
	.prose :global(h2) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(22px, 3vw, 27px);
		letter-spacing: -0.015em;
		line-height: 1.2;
		color: hsl(var(--theme-text));
		margin: 1.8em 0 0.6em;
	}
	.prose :global(h3) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(18px, 2.4vw, 21px);
		letter-spacing: -0.012em;
		line-height: 1.25;
		color: hsl(var(--theme-text));
		margin: 1.5em 0 0.5em;
	}
	.prose :global(.table-wrap) {
		overflow-x: auto;
		margin: 1.5em 0;
	}
	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-sans);
		font-size: 14.5px;
		line-height: 1.45;
		margin: 1.5em 0;
	}
	.prose :global(.table-wrap table) {
		margin: 0;
	}
	.prose :global(th),
	.prose :global(td) {
		text-align: left;
		padding: 9px 14px;
		border-bottom: 1px solid var(--hairline);
		vertical-align: top;
	}
	.prose :global(thead th) {
		font-weight: 600;
		color: hsl(var(--theme-text));
		border-bottom: 1.5px solid var(--hairline);
	}
	.prose :global(tbody td) {
		color: hsl(var(--theme-text-muted));
	}
	.prose :global(td[rowspan]) {
		font-weight: 600;
		color: hsl(var(--theme-text));
		background: var(--accent-soft);
		border-right: 1px solid var(--hairline);
		white-space: nowrap;
	}
	.prose :global(.tabset) {
		margin: 1.6em 0;
		border: 1px solid var(--hairline);
		border-radius: 10px;
		background: var(--paper);
		overflow: hidden;
		font-family: var(--font-sans);
	}
	.prose :global(.tabset .tabset) {
		margin: 0.4em 0 0.2em;
		border-radius: 8px;
	}
	.prose :global(.tabr) {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}
	.prose :global(.tabnav) {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		padding: 8px;
		background: var(--accent-soft);
		border-bottom: 1px solid var(--hairline);
	}
	.prose :global(.tabnav label) {
		cursor: pointer;
		padding: 7px 14px;
		font-size: 13.5px;
		font-weight: 600;
		line-height: 1;
		color: hsl(var(--theme-text-muted));
		border: 1px solid transparent;
		border-radius: 7px;
	}
	.prose :global(.tabnav label:hover) {
		color: hsl(var(--theme-text));
	}
	.prose :global(.tabpanes) {
		padding: 16px 18px;
	}
	.prose :global(.tabset .tabset .tabpanes) {
		padding: 13px 14px;
	}
	.prose :global(.pane) {
		display: none;
	}
	.prose :global(.pane h4) {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 16px;
		margin: 0 0 0.5em;
		color: hsl(var(--theme-text));
	}
	.prose :global(.pane h4:not(:first-child)) {
		margin-top: 1em;
	}
	.prose :global(.pane ol) {
		margin: 0 0 0.6em;
		padding-left: 1.25em;
	}
	.prose :global(.pane li) {
		margin: 0 0 0.45em;
		color: hsl(var(--theme-text-muted));
		font-size: 15px;
	}
	.prose :global(.pane p) {
		color: hsl(var(--theme-text-muted));
		font-size: 15px;
		margin: 0 0 0.6em;
	}
	.prose :global(.pane pre) {
		background: var(--accent-soft);
		border: 1px solid var(--hairline);
		border-radius: 6px;
		padding: 10px 12px;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.5;
		margin: 0.35em 0 0.85em;
	}
	.prose :global(.pane pre code) {
		font-family: var(--font-mono);
	}
	.prose :global(.pane .note) {
		font-size: 13.5px;
		border-left: 2px solid hsl(var(--theme-accent));
		padding-left: 10px;
	}
	.prose :global(#agent-cc:checked ~ .tabnav label[for="agent-cc"]),
	.prose :global(#agent-cx:checked ~ .tabnav label[for="agent-cx"]),
	.prose :global(#cc-mac:checked ~ .tabnav label[for="cc-mac"]),
	.prose :global(#cc-win:checked ~ .tabnav label[for="cc-win"]),
	.prose :global(#cc-lin:checked ~ .tabnav label[for="cc-lin"]),
	.prose :global(#cx-mac:checked ~ .tabnav label[for="cx-mac"]),
	.prose :global(#cx-win:checked ~ .tabnav label[for="cx-win"]),
	.prose :global(#cx-lin:checked ~ .tabnav label[for="cx-lin"]) {
		color: hsl(var(--theme-accent));
		background: var(--paper);
		border-color: var(--hairline);
	}
	.prose :global(#agent-cc:checked ~ .tabpanes > .pane-agent-cc),
	.prose :global(#agent-cx:checked ~ .tabpanes > .pane-agent-cx),
	.prose :global(#cc-mac:checked ~ .tabpanes > .pane-cc-mac),
	.prose :global(#cc-win:checked ~ .tabpanes > .pane-cc-win),
	.prose :global(#cc-lin:checked ~ .tabpanes > .pane-cc-lin),
	.prose :global(#cx-mac:checked ~ .tabpanes > .pane-cx-mac),
	.prose :global(#cx-win:checked ~ .tabpanes > .pane-cx-win),
	.prose :global(#cx-lin:checked ~ .tabpanes > .pane-cx-lin) {
		display: block;
	}
	.prose :global(a) {
		color: hsl(var(--theme-link));
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1px;
	}
	.prose :global(a:hover) {
		text-decoration: none;
	}
	.prose :global(.code-block) {
		position: relative;
		margin: 0.35em 0 0.85em;
	}
	.prose :global(.code-block > pre) {
		margin: 0;
		padding-right: 42px;
	}
	.prose :global(.copy-btn) {
		position: absolute;
		top: 6px;
		right: 6px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 1px solid var(--hairline);
		border-radius: 6px;
		background: var(--paper);
		color: hsl(var(--theme-text-muted));
		cursor: pointer;
		opacity: 0.75;
		transition: opacity 0.15s, color 0.15s;
	}
	.prose :global(.copy-btn:hover),
	.prose :global(.copy-btn.copied) {
		opacity: 1;
		color: hsl(var(--theme-accent));
	}
	.prose :global(.copy-btn svg) {
		width: 15px;
		height: 15px;
	}
</style>

<script>
	const COPY_ICON =
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
	const DONE_ICON =
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

	document.querySelectorAll(".prose pre").forEach((pre) => {
		const code = pre.querySelector("code");
		if (!code || !pre.parentNode) return;
		const wrap = document.createElement("div");
		wrap.className = "code-block";
		pre.parentNode.insertBefore(wrap, pre);
		wrap.appendChild(pre);

		const btn = document.createElement("button");
		btn.type = "button";
		btn.className = "copy-btn";
		btn.setAttribute("aria-label", "Copy to clipboard");
		btn.innerHTML = COPY_ICON;
		btn.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(code.textContent);
				btn.innerHTML = DONE_ICON;
				btn.classList.add("copied");
				btn.setAttribute("aria-label", "Copied");
				setTimeout(() => {
					btn.innerHTML = COPY_ICON;
					btn.classList.remove("copied");
					btn.setAttribute("aria-label", "Copy to clipboard");
				}, 1500);
			} catch (e) {}
		});
		wrap.appendChild(btn);
	});
</script>
