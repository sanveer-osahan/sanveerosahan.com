---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { siteConfig } from "@/site-config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/*
	 * Widens the shell to fit a second column beside the prose. Only the
	 * Article and Reading pages set it. The prose column itself stays 760px
	 * wide, so this moves the block off centre without changing line length.
	 */
	wide?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	wide = false,
} = Astro.props;
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<ThemeProvider />
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
	</head>
	<body>
		<SkipLink />
		<div class:list={["wrap", { wide }]}>
			<Header />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>

		<style is:global>
			html {
				scrollbar-gutter: stable;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				/*
				 * `clip`, not `hidden`. Both stop the page scrolling sideways, but
				 * `hidden` makes this element a scroll container, and a scroll
				 * container ancestor is what a `position: sticky` descendant sticks
				 * to. That killed the Contents column: it stuck to a box that never
				 * scrolls, so it scrolled away with the prose. `clip` creates no
				 * scroll container, so sticky still resolves against the viewport.
				 */
				overflow-x: clip;
			}
			body {
				background-color: hsl(var(--theme-bg));
				color: hsl(var(--theme-text));
				font-family: var(--font-serif);
				font-size: 18px;
				line-height: 1.62;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
				min-height: 100vh;
				min-height: 100dvh;
			}
			html.theme-ready body {
				transition: background-color 0.35s ease, color 0.35s ease;
			}
			a {
				color: inherit;
				text-decoration: none;
				transition: color 0.2s ease, border-color 0.2s ease;
			}

			/* Sticky footer: wrap fills viewport, main grows to push footer down */
			.wrap {
				max-width: 760px;
				margin: 0 auto;
				padding: 36px max(32px, env(safe-area-inset-right))
					max(80px, env(safe-area-inset-bottom)) max(32px, env(safe-area-inset-left));
				min-height: 100vh;
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
			}
			.wrap > main { flex: 1 0 auto; }
			/*
			 * 1120 = 760 prose + 56 gap + 240 Contents + 64 padding. Below it the
			 * two columns no longer fit, so the shell drops back to the 760px
			 * every other page uses and the Contents column is hidden.
			 */
			.wrap.wide {
				max-width: 1120px;
			}
			@media (max-width: 1120px) {
				.wrap.wide {
					max-width: 760px;
				}
			}

			@media (max-width: 720px) {
				.wrap {
					padding: 18px max(22px, env(safe-area-inset-right))
						max(56px, env(safe-area-inset-bottom)) max(22px, env(safe-area-inset-left));
				}
				body {
					font-size: 17px;
				}
			}

			@media (max-width: 420px) {
				.wrap {
					padding: 14px max(16px, env(safe-area-inset-right))
						max(44px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
				}
				body {
					font-size: 16.5px;
				}
			}
		</style>
	</body>
</html>
